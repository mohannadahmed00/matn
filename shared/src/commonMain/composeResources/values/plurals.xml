<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Arabic has 6 grammatical plural categories (CLDR); "بيت" (verse) inflects across all of
         them, unlike most other strings in this app, so this is the one count that genuinely
         needs a <plurals> resource rather than a single %1$d string (see android-code-guard
         Compose review — a flat string produced the wrong noun form for every count but one). -->
    <plurals name="verses_count">
        <item quantity="zero">لا أبيات</item>
        <item quantity="one">بيت واحد</item>
        <item quantity="two">بيتان</item>
        <item quantity="few">%1$d أبيات</item>
        <item quantity="many">%1$d بيتًا</item>
        <item quantity="other">%1$d بيت</item>
    </plurals>
    <!-- Library header summary ("N downloaded · 36 MB"). Same reasoning as verses_count: "متن"
         inflects across all six CLDR categories, so a flat "%1$d متن منزَّل" would be wrong for
         every count but one. -->
    <plurals name="downloaded_count">
        <item quantity="zero">لا متون منزَّلة</item>
        <item quantity="one">متن منزَّل</item>
        <item quantity="two">متنان منزَّلان</item>
        <item quantity="few">%1$d متون منزَّلة</item>
        <item quantity="many">%1$d متنًا منزَّلًا</item>
        <item quantity="other">%1$d متن منزَّل</item>
    </plurals>
</resources>
