-- Phase 8 (schema v4 -> v5): additive content_pack table. Named for the version it migrates FROM
-- (SQLDelight convention), so this is `4.sqm`, bumping `ContentDatabase.Schema.version` to 5. The
-- CREATE TABLE text below MUST stay byte-identical to Content.sq's `content_pack` definition —
-- MigrationV4Test is the guard that proves the upgrade path (data-model.md §1.1).

CREATE TABLE content_pack (
    matn_id              TEXT NOT NULL PRIMARY KEY REFERENCES matn(id) ON DELETE CASCADE,
    pack_id              TEXT NOT NULL UNIQUE,
    declared_size_bytes  INTEGER NOT NULL,
    is_starter           INTEGER NOT NULL DEFAULT 0
);