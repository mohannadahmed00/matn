-- Phase 13 (FR-002, FR-005, data-model §1.1): the student-visible summary of one published matn,
-- replacing Phase 8's `content_pack`. Lifetime differs from every content table below: an overview
-- persists from the first successful sync regardless of download state, so the catalog browses in
-- full with no connectivity. Carries no verse text and no audio (FR-003).
--
-- `download_size_bytes` is the teacher's published `declared_size_bytes`, so a size always renders
-- offline and FR-019's free-space check never waits on a lookup. `revision` is the server-owned
-- monotonic counter (Phase 11's `matns_bump_revision` trigger) that drives the update flag
-- (FR-010). `withdrawn` marks a matn that vanished from the source while still downloaded — it is
-- excluded from anything offering a new download, but keeps rendering for the content the student
-- already has (FR-009). No availability column: availability is derived from what is on disk every
-- time (FR-022).
CREATE TABLE catalog_overview (
    matn_id             TEXT NOT NULL PRIMARY KEY,
    title               TEXT NOT NULL,
    author              TEXT NOT NULL,
    description         TEXT NOT NULL,
    cover_image_ref     TEXT,
    structure_kind      TEXT NOT NULL,
    verse_count         INTEGER NOT NULL,
    download_size_bytes INTEGER NOT NULL,
    audio_completeness  TEXT NOT NULL,
    revision            INTEGER NOT NULL,
    withdrawn           INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX catalog_overview_by_title ON catalog_overview(title);

-- Phase 13 (FR-006, FR-044, data-model §1.2): exactly one row. `last_success_at_millis IS NULL` is
-- "never synced" — the only state that may show the connect-to-browse prompt; a non-null value with
-- zero overviews is "reachable but empty". Also the basis for the 1-hour staleness window.
CREATE TABLE catalog_sync_state (
    id                     INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    last_success_at_millis INTEGER,
    last_attempt_failed    INTEGER NOT NULL DEFAULT 0
);

-- Phase 13 (FR-010, data-model §1.3): bookkeeping for a matn whose content is on the device,
-- recording the revision the content was built from. This row is NOT the availability flag —
-- FR-022 requires availability to come from what is actually on disk, so a row whose
-- `downloads/{matnId}/` directory is missing resolves to NotDownloaded and is reaped (FR-045).
CREATE TABLE downloaded_matn (
    matn_id              TEXT NOT NULL PRIMARY KEY,
    revision             INTEGER NOT NULL,
    downloaded_at_millis INTEGER NOT NULL
);

CREATE TABLE matn (
    id             TEXT NOT NULL PRIMARY KEY,
    title          TEXT NOT NULL,
    author         TEXT NOT NULL,
    description    TEXT NOT NULL,
    cover_image_ref TEXT,
    structure_kind TEXT NOT NULL
);

CREATE TABLE chapter (
    id             TEXT NOT NULL PRIMARY KEY,
    matn_id        TEXT NOT NULL,
    title          TEXT NOT NULL,
    display_order  INTEGER NOT NULL,
    FOREIGN KEY (matn_id) REFERENCES matn(id),
    UNIQUE (matn_id, display_order)
);

CREATE TABLE verse (
    id             TEXT NOT NULL PRIMARY KEY,
    matn_id        TEXT NOT NULL,
    chapter_id     TEXT,
    display_number INTEGER NOT NULL,
    arabic_text    TEXT NOT NULL,
    duration_ms    INTEGER NOT NULL,
    FOREIGN KEY (matn_id) REFERENCES matn(id),
    FOREIGN KEY (chapter_id) REFERENCES chapter(id),
    UNIQUE (matn_id, display_number)
);

CREATE TABLE audio_asset (
    id             TEXT NOT NULL PRIMARY KEY,
    verse_id       TEXT NOT NULL,
    reciter_id     TEXT NOT NULL,
    file_ref       TEXT NOT NULL,
    duration_ms    INTEGER NOT NULL,
    FOREIGN KEY (verse_id) REFERENCES verse(id),
    UNIQUE (verse_id, reciter_id)
);

-- Phase 1 (FR-017): additive key/value settings row, forward-compatible for later settings.
-- Reading font size is stored under key 'reading_font_size' with the enum constant name;
-- absent/unrecognized values resolve to the DEFAULT (MEDIUM) in the repository, never crash.
CREATE TABLE app_setting (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Phase 4 (FR-001): one saved session row per matn. Deliberately stores NO mode (derived,
-- FR-005), NO repetition progress (FR-006), and NO playing/paused flag (resume always plays).
-- last_verse_display_number is the ordinal anchor that keeps "nearest surviving verse"
-- computable after the verse row is deleted (FR-026).
-- Phase 13 (research D5): the FK to `matn` is GONE. Removal now deletes matn/verse rows
-- (FR-013 downloads them, FR-028 removes them), and the old ON DELETE CASCADE would have taken the
-- student's resume position with it — violating FR-026, FR-029 and SC-010. `matn_id` is the
-- teacher-owned stable UUID, so the row simply re-resolves when the matn is downloaded again.
CREATE TABLE matn_session (
    matn_id                    TEXT NOT NULL PRIMARY KEY,
    last_verse_id              TEXT NOT NULL,
    last_verse_display_number  INTEGER NOT NULL,
    position_ms                INTEGER NOT NULL,
    verse_repeat               TEXT NOT NULL,
    matn_repeat                TEXT NOT NULL,
    loop_start_verse_id        TEXT,
    loop_end_verse_id          TEXT
);

CREATE INDEX verse_by_matn_order ON verse(matn_id, display_number);
CREATE INDEX verse_by_chapter    ON verse(chapter_id);
CREATE INDEX audio_by_verse      ON audio_asset(verse_id);

-- Phase 6 (FR-010…FR-014): at most one bookmark per verse. `id` is a UUID minted at creation
-- (Constitution VI — sync-safe identity), independent of `verse_id`; UNIQUE(verse_id) both
-- enforces the one-per-verse rule and doubles as the per-verse lookup index.
--
-- Phase 13 (research D5): the FK to `verse` is GONE. Phase 6's CASCADE was safe only because verse
-- rows were seeded into the binary and never deleted; now that a download owns them, a removal
-- would have cascaded every bookmark away (FR-029, SC-010). Orphans are kept, never collected, and
-- re-resolve on re-download; reads that need verse context INNER JOIN and so hide them.
CREATE TABLE bookmark (
    id         TEXT NOT NULL PRIMARY KEY,
    verse_id   TEXT NOT NULL UNIQUE,
    created_at INTEGER NOT NULL
);

CREATE INDEX bookmark_by_verse ON bookmark(verse_id);

-- Phase 6 (FR-015…FR-019): at most one note per verse; `id` stays stable across edits (only
-- `text`/`updated_at` change). `text` is NOT NULL and never stored empty — the domain layer
-- rejects blank saves before reaching this table (FR-019).
-- Phase 13 (research D5): FK to `verse` removed, same reasoning as `bookmark`.
CREATE TABLE note (
    id         TEXT NOT NULL PRIMARY KEY,
    verse_id   TEXT NOT NULL UNIQUE,
    text       TEXT NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX note_by_verse ON note(verse_id);

selectMatnById:
SELECT * FROM matn WHERE id = ?;

selectAllMatn:
SELECT * FROM matn ORDER BY title;

-- Phase 1 (FR-002): derived library summary projection. LEFT JOIN verse so a matn with zero
-- verses still appears (count 0, sum 0). No schema change; purely a read-only aggregate.
selectLibrarySummaries:
SELECT
    matn.id AS id,
    matn.title AS title,
    matn.author AS author,
    matn.description AS description,
    matn.cover_image_ref AS cover_image_ref,
    matn.structure_kind AS structure_kind,
    COUNT(verse.id) AS verse_count,
    COALESCE(SUM(verse.duration_ms), 0) AS total_duration_ms,
    -- Phase 13: the size now comes from the synced overview, not a local authored row.
    COALESCE(catalog_overview.download_size_bytes, 0) AS declared_size_bytes
FROM matn
LEFT JOIN verse ON verse.matn_id = matn.id
LEFT JOIN catalog_overview ON catalog_overview.matn_id = matn.id
GROUP BY matn.id
ORDER BY matn.title;

selectChaptersByMatn:
SELECT * FROM chapter WHERE matn_id = ? ORDER BY display_order;

-- Phase 6 (research.md D2): search-corpus reads, library-wide, in-memory filtered by
-- ArabicNormalizer. Reactive (asFlow/mapToList) so content changes re-emit current results.
selectAllChapters:
SELECT * FROM chapter ORDER BY matn_id, display_order;

selectAllVerses:
SELECT * FROM verse ORDER BY matn_id, display_number;

selectVersesByMatn:
SELECT * FROM verse WHERE matn_id = ? ORDER BY display_number;

selectVersesByChapter:
SELECT * FROM verse WHERE chapter_id = ? ORDER BY display_number;

selectVerseById:
SELECT * FROM verse WHERE id = ?;

selectSetting:
SELECT value FROM app_setting WHERE key = ?;

upsertSetting:
INSERT INTO app_setting(key,value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value = excluded.value;

selectAudioForVerse:
SELECT * FROM audio_asset WHERE verse_id = ? AND reciter_id = ?;

-- Phase 2 (FR-005/FR-006): a matn's per-verse audio in matn-global reading order, for one reciter.
-- INNER JOIN drops verses with no audio row for this reciter (a defensive case only — Phase 0 V4
-- validation guarantees every verse has audio for validly-seeded content). Order is authoritative
-- verse.display_number, not storage order.
selectAudioForMatnOrdered:
SELECT audio_asset.*
FROM audio_asset
JOIN verse ON verse.id = audio_asset.verse_id
WHERE verse.matn_id = ? AND audio_asset.reciter_id = ?
ORDER BY verse.display_number;

selectVerseIdsByMatn:
SELECT id FROM verse WHERE matn_id = ?;

upsertMatn:
INSERT INTO matn(id,title,author,description,cover_image_ref,structure_kind) VALUES (?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET title=excluded.title, author=excluded.author, description=excluded.description, cover_image_ref=excluded.cover_image_ref, structure_kind=excluded.structure_kind;

upsertChapter:
INSERT INTO chapter(id,matn_id,title,display_order) VALUES (?,?,?,?) ON CONFLICT(id) DO UPDATE SET matn_id=excluded.matn_id, title=excluded.title, display_order=excluded.display_order;

upsertVerse:
INSERT INTO verse(id,matn_id,chapter_id,display_number,arabic_text,duration_ms) VALUES (?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET matn_id=excluded.matn_id, chapter_id=excluded.chapter_id, display_number=excluded.display_number, arabic_text=excluded.arabic_text, duration_ms=excluded.duration_ms;

upsertAudioAsset:
INSERT INTO audio_asset(id,verse_id,reciter_id,file_ref,duration_ms) VALUES (?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET verse_id=excluded.verse_id, reciter_id=excluded.reciter_id, file_ref=excluded.file_ref, duration_ms=excluded.duration_ms;

deleteAudioByMatn:
DELETE FROM audio_asset WHERE verse_id IN (SELECT id FROM verse WHERE matn_id = ?);

deleteVersesByMatn:
DELETE FROM verse WHERE matn_id = ?;

deleteChaptersByMatn:
DELETE FROM chapter WHERE matn_id = ?;

deleteMatnById:
DELETE FROM matn WHERE id = ?;

selectSession:
SELECT * FROM matn_session WHERE matn_id = ?;

upsertSession:
INSERT INTO matn_session(matn_id,last_verse_id,last_verse_display_number,position_ms,verse_repeat,matn_repeat,loop_start_verse_id,loop_end_verse_id)
VALUES (?,?,?,?,?,?,?,?)
ON CONFLICT(matn_id) DO UPDATE SET
  last_verse_id=excluded.last_verse_id,
  last_verse_display_number=excluded.last_verse_display_number,
  position_ms=excluded.position_ms,
  verse_repeat=excluded.verse_repeat,
  matn_repeat=excluded.matn_repeat,
  loop_start_verse_id=excluded.loop_start_verse_id,
  loop_end_verse_id=excluded.loop_end_verse_id;

deleteSetting:
DELETE FROM app_setting WHERE key = ?;

-- Phase 6: bookmark queries (annotations-contract.md § Repository interfaces).

selectBookmarkByVerse:
SELECT * FROM bookmark WHERE verse_id = ?;

insertBookmark:
INSERT INTO bookmark(id, verse_id, created_at) VALUES (?, ?, ?);

deleteBookmarkByVerse:
DELETE FROM bookmark WHERE verse_id = ?;

-- Newest-first, deterministic tiebreak by id (annotations-contract.md § Semantics 4).
-- Phase 13 (research D5): the two JOINs below are now LOAD-BEARING, not incidental. With the
-- `bookmark.verse_id` foreign key gone, a bookmark outlives its verse when the matn is removed
-- (FR-029). These are INNER joins, so such a bookmark simply does not appear here — hidden, never
-- deleted, and re-resolved when the matn is downloaded again. Do NOT relax either to a LEFT JOIN.
selectAllBookmarksWithContext:
SELECT
    bookmark.id AS id,
    bookmark.verse_id AS verse_id,
    bookmark.created_at AS created_at,
    matn.id AS matn_id,
    matn.title AS matn_title,
    verse.display_number AS verse_number,
    verse.arabic_text AS verse_text
FROM bookmark
JOIN verse ON verse.id = bookmark.verse_id
JOIN matn ON matn.id = verse.matn_id
ORDER BY bookmark.created_at DESC, bookmark.id DESC;

selectBookmarkedVerseIdsByMatn:
SELECT bookmark.verse_id AS verse_id
FROM bookmark
JOIN verse ON verse.id = bookmark.verse_id
WHERE verse.matn_id = ?;

-- Phase 6: note queries (annotations-contract.md § Repository interfaces).

selectNoteByVerse:
SELECT * FROM note WHERE verse_id = ?;

-- Create-or-replace keeping the original id (data-model.md — id stable across edits).
upsertNote:
INSERT INTO note(id, verse_id, text, updated_at) VALUES (?, ?, ?, ?)
ON CONFLICT(verse_id) DO UPDATE SET text = excluded.text, updated_at = excluded.updated_at;

deleteNoteByVerse:
DELETE FROM note WHERE verse_id = ?;

-- Newest-first, deterministic tiebreak by id (annotations-contract.md § Semantics 4).
-- Phase 13 (research D5): same orphan guard as selectAllBookmarksWithContext — these INNER joins
-- are what hide a note whose matn has been removed. Do NOT relax either to a LEFT JOIN.
selectAllNotesWithContext:
SELECT
    note.id AS id,
    note.verse_id AS verse_id,
    note.text AS text,
    note.updated_at AS updated_at,
    matn.id AS matn_id,
    matn.title AS matn_title,
    verse.display_number AS verse_number,
    verse.arabic_text AS verse_text
FROM note
JOIN verse ON verse.id = note.verse_id
JOIN matn ON matn.id = verse.matn_id
ORDER BY note.updated_at DESC, note.id DESC;

selectNotedVerseIdsByMatn:
SELECT note.verse_id AS verse_id
FROM note
JOIN verse ON verse.id = note.verse_id
WHERE verse.matn_id = ?;

-- Phase 7 (FR-001…FR-005): explicit per-verse recall self-report. `id` is a UUID minted at
-- creation (Constitution VI); UNIQUE(verse_id) enforces one status per verse and doubles as the
-- lookup index.
-- Phase 13 (research D5): FK to `verse` removed — a removal must never erase a memorized mark
-- (FR-029, SC-010). `selectAllMatnProgress` is anchored `FROM matn`, so an orphan can never be
-- counted as memorized.
CREATE TABLE memorization (
    id           TEXT NOT NULL PRIMARY KEY,
    verse_id     TEXT NOT NULL UNIQUE,
    memorized_at INTEGER NOT NULL
);

CREATE INDEX memorization_by_verse ON memorization(verse_id);

-- Phase 7 (FR-010…FR-014): append-only record of distinct verses practiced per LOCAL day.
-- UNIQUE(day_epoch, verse_id) enforces at-most-once-per-verse-per-day; rows are never deleted
-- by un-marking a verse (FR-014).
-- Phase 13 (research D5): FK to `verse` removed. Note the deliberate consequence recorded on
-- `selectDailyPracticeCount` below — practice is a historical fact and keeps counting after the
-- matn is removed (FR-026).
CREATE TABLE daily_practice (
    id           TEXT NOT NULL PRIMARY KEY,
    day_epoch    INTEGER NOT NULL,
    verse_id     TEXT NOT NULL,
    practiced_at INTEGER NOT NULL,
    UNIQUE (day_epoch, verse_id)
);

CREATE INDEX daily_practice_by_verse ON daily_practice(verse_id);

-- Phase 7: memorization queries (progress-contract.md § Repository interfaces).

selectMemorizationByVerse:
SELECT * FROM memorization WHERE verse_id = ?;

insertMemorization:
INSERT OR IGNORE INTO memorization(id, verse_id, memorized_at) VALUES (?, ?, ?);

deleteMemorizationByVerse:
DELETE FROM memorization WHERE verse_id = ?;

selectMemorizedVerseIdsByMatn:
SELECT memorization.verse_id AS verse_id
FROM memorization
JOIN verse ON verse.id = memorization.verse_id
WHERE verse.matn_id = ?;

selectMemorizedVerseIdsByChapter:
SELECT memorization.verse_id AS verse_id
FROM memorization
JOIN verse ON verse.id = memorization.verse_id
WHERE verse.chapter_id = ?;

-- Phase 7 (FR-006/FR-008, research D4): the ONE progress aggregate. LEFT JOINs keep a
-- zero-verse matn present with total 0 / memorized 0 (no divide-by-zero downstream).
selectAllMatnProgress:
SELECT
    matn.id AS matn_id,
    COUNT(verse.id) AS total_verses,
    COUNT(memorization.verse_id) AS memorized_verses
FROM matn
LEFT JOIN verse ON verse.matn_id = matn.id
LEFT JOIN memorization ON memorization.verse_id = verse.id
GROUP BY matn.id
ORDER BY matn.title;

selectMatnProgressById:
SELECT
    matn.id AS matn_id,
    COUNT(verse.id) AS total_verses,
    COUNT(memorization.verse_id) AS memorized_verses
FROM matn
LEFT JOIN verse ON verse.matn_id = matn.id
LEFT JOIN memorization ON memorization.verse_id = verse.id
WHERE matn.id = ?
GROUP BY matn.id;

-- Phase 7: daily practice (append-only; OR IGNORE absorbs same-day duplicates, FR-010).

insertDailyPractice:
INSERT OR IGNORE INTO daily_practice(id, day_epoch, verse_id, practiced_at) VALUES (?, ?, ?, ?);

-- Phase 13 (research D5, tasks T013): this query DELIBERATELY has no verse join, so it keeps
-- counting practice rows whose verse was removed. Practising happened; removing the matn afterwards
-- does not un-happen it, and FR-026 forbids losing personal data. Adding an INNER JOIN here would
-- silently rewrite the student's history for the day. `OrphanPersonalDataTest` pins this.
selectDailyPracticeCount:
SELECT COUNT(*) AS practiced_count FROM daily_practice WHERE day_epoch = ?;

-- Phase 13 (data-model §1.1, §1.2, §1.3): catalog, sync-state and downloaded-matn queries,
-- replacing Phase 8's content_pack set.

selectAllCatalogOverviews:
SELECT * FROM catalog_overview ORDER BY title;

selectCatalogOverviewById:
SELECT * FROM catalog_overview WHERE matn_id = ?;

upsertCatalogOverview:
INSERT OR REPLACE INTO catalog_overview(
    matn_id, title, author, description, cover_image_ref, structure_kind,
    verse_count, download_size_bytes, audio_completeness, revision, withdrawn
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCatalogOverviewById:
DELETE FROM catalog_overview WHERE matn_id = ?;

-- FR-009: a matn that vanished from the source but is still downloaded keeps its overview so the
-- downloaded copy stays fully renderable offline; `withdrawn` is what excludes it from being
-- offered as a new download.
markCatalogOverviewWithdrawn:
UPDATE catalog_overview SET withdrawn = 1 WHERE matn_id = ?;

selectSyncState:
SELECT * FROM catalog_sync_state WHERE id = 1;

upsertSyncState:
INSERT OR REPLACE INTO catalog_sync_state(id, last_success_at_millis, last_attempt_failed)
VALUES (1, ?, ?);

selectDownloadedMatn:
SELECT * FROM downloaded_matn WHERE matn_id = ?;

selectAllDownloadedMatns:
SELECT * FROM downloaded_matn;

insertDownloadedMatn:
INSERT OR REPLACE INTO downloaded_matn(matn_id, revision, downloaded_at_millis) VALUES (?, ?, ?);

deleteDownloadedMatn:
DELETE FROM downloaded_matn WHERE matn_id = ?;